# Copy to .env and fill in. Never commit .env. Set the same values in the
# Vercel project (Settings, Environment Variables) for production.
#
# Without DATABASE_URL, `npm run dev` uses a local database in .ncs-dev/ and
# prints a local access code, so the panel works before anything is set up.

# Supabase: Project Settings > Database > Connection string > Transaction pooler
# (port 6543). The direct db.<ref>.supabase.co address is IPv6 only and
# Vercel can't reach it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Signs the admin session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# Vercel sends this with the daily uptime check (vercel.json "crons").
CRON_SECRET=

# Supabase project details (not needed by the admin panel itself yet).
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL_DIRECT=
